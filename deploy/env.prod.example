# Copy to /srv/factory-floor/.env on the VM and fill in by hand. Never commit
# the real file. No quotes around values. deploy.sh refuses to run if any name
# below is empty. Use hex for the passwords (openssl rand -hex 24) because
# compose puts them into connection URLs.
# Compose sets NODE_ENV, PORT, HOST, TRUST_PROXY, SIM_ENABLED, API_INTERNAL_URL
# and all three connection URLs itself, so they are not listed here.

# Postgres superuser, used only to create the roles on first start.
POSTGRES_SUPERUSER_PASSWORD=
# ff_owner runs migrations; ff_app serves traffic.
FF_OWNER_PASSWORD=
FF_APP_PASSWORD=
# RabbitMQ login.
RABBIT_USER=
RABBIT_PASSWORD=
# Signs the guest cookie; 32+ random characters.
COOKIE_SECRET=
# Signs the admin session; 32+ random characters.
ADMIN_JWT_SECRET=
# The simulator's key for x-sim-key; 32+ random characters.
SIM_KEY=
# Password for the admin login, written to the database by the seed step.
ADMIN_PASSWORD=
# Optional, defaults to https://factory.tahmidalavi.com. Not checked by deploy.sh.
# WEB_ORIGIN=
