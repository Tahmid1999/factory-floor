{
  "name": "factory-floor-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "migrate": "dotenv run -f ../.env -- node scripts/migrate.js",
    "migrate:prod": "node scripts/migrate.js",
    "migrate:test": "dotenv run -f ../.env -- node scripts/migrate.js test",
    "seed": "ts-node src/seed-cli.ts",
    "seed:prod": "node dist/seed-cli.js",
    "seed:history": "ts-node src/seed-history.ts",
    "seed:history:prod": "node dist/seed-history.js",
    "test": "jest --config jest.config.json",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "6.19",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.19",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
